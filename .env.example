PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Any long random string. Used to sign login sessions.
# In production this MUST be at least 20 characters, or the server refuses to start.
JWT_SECRET=change-this-to-a-long-random-string

# From console.anthropic.com — a Commercial Terms API key, not your personal Claude.ai login.
ANTHROPIC_API_KEY=sk-ant-xxxx

# From your Stripe dashboard, once you've created a subscription product.
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PRICE_ID=price_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# How many entries a new account can create before it must subscribe.
FREE_TRIAL_ENTRIES=5

# Where the SQLite file lives. Make sure this path is on persistent storage in production.
DB_PATH=./data.sqlite
